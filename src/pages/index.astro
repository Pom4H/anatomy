---
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://pom4h.github.io');
const slugOf = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    description: SITE.description,
    url: new URL(base, site).href,
    inLanguage: SITE.language,
    author: {
      '@type': 'Person',
      name: SITE.author,
      url: SITE.authorUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: SITE.title,
    description: SITE.description,
    url: new URL(base, site).href,
    hasPart: articles.map((article) => ({
      '@type': 'LearningResource',
      headline: article.data.title,
      educationalLevel: article.data.level,
      teaches: article.data.learningObjectives,
      url: new URL(`${base}${slugOf(article.id)}/`, site).href,
    })),
  },
];

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout structuredData={structuredData} bodyClass="home-page learning-library">
  <SiteHeader />

  <main id="content">
    <section class="home-hero" aria-labelledby="home-title">
      <p class="home-hero__kicker">Visual lessons · systems from first principles</p>
      <h1 id="home-title">
        Understand how<br />
        <em>technology works.</em>
      </h1>
      <div class="home-hero__aside">
        <p>
          Start with the mental model. Follow the data. Find the trust boundary.
          Then inspect the implementation.
        </p>
        <span aria-hidden="true">↓</span>
      </div>
    </section>

    <section class="home-boundary" aria-label="Learning method">
      <span>MODEL</span>
      <div><b>follow the data flow</b><i></i><b>locate the authority</b></div>
      <span>VERIFY</span>
    </section>

    <section class="issues" aria-labelledby="issues-title">
      <header class="section-heading">
        <p>Lessons</p>
        <h2 id="issues-title">Start here</h2>
      </header>

      <div class="issue-list">
        {articles.map((article) => {
          const issue = String(article.data.issue).padStart(3, '0');
          const slug = slugOf(article.id);
          return (
            <a class="issue-entry" href={`${base}${slug}/`}>
              <span class="issue-entry__number">{issue}</span>
              <div class="issue-entry__body">
                <p class="issue-entry__category">{article.data.category} · {article.data.level}</p>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <div class="issue-entry__meta">
                <time datetime={article.data.publishedAt.toISOString()}>
                  {dateFormat.format(article.data.publishedAt)}
                </time>
                <span>{article.data.readingMinutes} min</span>
                <b aria-hidden="true">↘</b>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
