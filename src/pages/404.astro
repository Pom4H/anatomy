---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const home = import.meta.env.BASE_URL;
---

<BaseLayout title="Страница не найдена — Anatomy" description="Такой страницы в Anatomy нет." noindex>
  <SiteHeader />
  <main id="content" class="not-found">
    <p>404 / OUT OF BOUNDS</p>
    <h1>Этой части системы пока нет.</h1>
    <a class="text-arrow" href={home}>Вернуться к разборам <span>↙</span></a>
  </main>
  <SiteFooter />
</BaseLayout>
