---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { SITE } from '../config';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((post) => ({
    params: { id: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'articles'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://pom4h.github.io');
const slug = post.id.replace(/\.(md|mdx)$/i, '');
const canonical = new URL(`${base}${slug}/`, site);
const image = new URL(`${base}${post.data.socialImage}`, site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['TechArticle', 'LearningResource'],
  headline: post.data.title,
  alternativeHeadline: post.data.seoTitle,
  description: post.data.description,
  image: image.href,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: canonical.href,
  inLanguage: SITE.language,
  isAccessibleForFree: true,
  wordCount: post.data.wordCount,
  timeRequired: `PT${post.data.readingMinutes}M`,
  learningResourceType: 'Visual lesson',
  educationalUse: 'Instruction',
  educationalLevel: post.data.level,
  teaches: post.data.learningObjectives,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: SITE.authorUrl,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.authorUrl,
  },
  about: post.data.tags,
  codeRepository: post.data.repository,
};
---

<ArticleLayout post={post} headings={headings} structuredData={structuredData}>
  <Content />
</ArticleLayout>
