---
import type { CollectionEntry } from 'astro:content';
import ArticleToc from '../components/ArticleToc.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'articles'>;
  headings: Heading[];
  structuredData: Record<string, unknown> | Record<string, unknown>[];
}

const { post, headings, structuredData } = Astro.props;
const { data } = post;
const issue = String(data.issue).padStart(3, '0');
const dateFormat = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${data.seoTitle} — Anatomy`}
  description={data.description}
  image={data.socialImage}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  tags={data.tags}
  structuredData={structuredData}
  bodyClass="article-page"
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <SiteHeader />

  <main id="content">
    <article class="article" itemscope itemtype="https://schema.org/TechArticle">
      <header class="article-hero">
        <div class="article-hero__eyebrow">
          <span>Выпуск {issue}</span>
          <span>{data.category}</span>
          <span class="status-mark">Experimental</span>
        </div>

        <h1 itemprop="headline">{data.title}</h1>
        <p class="article-hero__dek" itemprop="description">{data.description}</p>

        <div class="article-hero__meta">
          <div>
            <span class="meta-label">Автор</span>
            <a href="https://rom4.ru" rel="author">{data.author}</a>
          </div>
          <div>
            <span class="meta-label">Опубликовано</span>
            <time datetime={data.publishedAt.toISOString()}>{dateFormat.format(data.publishedAt)}</time>
          </div>
          <div>
            <span class="meta-label">Чтение</span>
            <span>{data.readingMinutes} минут</span>
          </div>
          <div>
            <span class="meta-label">Исходный код</span>
            <a href={data.repository}>GitHub ↗</a>
          </div>
        </div>
      </header>

      <div class="article-rule" aria-hidden="true">
        <span>HOST</span>
        <span class="article-rule__boundary">TRUST BOUNDARY</span>
        <span>DEVICE</span>
      </div>

      <div class="article-grid">
        <aside class="article-sidebar">
          <ArticleToc headings={headings} />
          <p class="source-stamp">
            Source snapshot<br />
            <code>{data.sourceCommit.slice(0, 10)}</code>
          </p>
        </aside>

        <div class="prose" itemprop="articleBody">
          <slot />
        </div>
      </div>

      <footer class="article-end">
        <span class="article-end__index">/{issue}</span>
        <div>
          <p>Исходники и точные границы поддерживаемых операций находятся в репозитории.</p>
          <a class="text-arrow" href={data.repository}>Открыть Hardware Wallet на GitHub <span>↗</span></a>
        </div>
      </footer>
    </article>
  </main>

  <SiteFooter />

  <script is:inline>
    const progress = document.querySelector('.reading-progress span');
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      if (!(progress instanceof HTMLElement)) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progress.style.transform = `scaleX(${value})`;
    };

    window.addEventListener('scroll', () => {
      if (!frame) frame = window.requestAnimationFrame(updateProgress);
    }, { passive: true });

    updateProgress();
  </script>
</BaseLayout>
