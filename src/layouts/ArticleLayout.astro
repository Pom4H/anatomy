---
import type { CollectionEntry } from 'astro:content';
import ArticleToc from '../components/ArticleToc.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/motion.css';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'articles'>;
  headings: Heading[];
  structuredData: Record<string, unknown> | Record<string, unknown>[];
}

const { post, headings, structuredData } = Astro.props;
const { data } = post;
const issue = String(data.issue).padStart(3, '0');
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={`${data.seoTitle} — Anatomy`}
  description={data.description}
  image={data.socialImage}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  tags={data.tags}
  structuredData={structuredData}
  bodyClass="article-page lesson-page"
>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <SiteHeader />

  <main id="content">
    <article class="article" itemscope itemtype="https://schema.org/TechArticle">
      <header class="article-hero lesson-hero">
        <div class="article-hero__eyebrow">
          <span>Lesson {issue}</span>
          <span>{data.category}</span>
          <span>{data.level}</span>
        </div>

        <h1 itemprop="headline">{data.title}</h1>
        <p class="article-hero__dek" itemprop="description">{data.description}</p>

        <div class="article-hero__meta">
          <div>
            <span class="meta-label">Written by</span>
            <a href="https://rom4.ru" rel="author">{data.author}</a>
          </div>
          <div>
            <span class="meta-label">Updated</span>
            <time datetime={(data.updatedAt ?? data.publishedAt).toISOString()}>
              {dateFormat.format(data.updatedAt ?? data.publishedAt)}
            </time>
          </div>
          <div>
            <span class="meta-label">Learning time</span>
            <span>{data.readingMinutes} minutes</span>
          </div>
          <div>
            <span class="meta-label">Reference code</span>
            <a href={data.repository}>Open on GitHub ↗</a>
          </div>
        </div>
      </header>

      <div class="article-rule lesson-rule" aria-hidden="true">
        <span>KEYS</span>
        <span class="article-rule__boundary">TRANSACTIONS</span>
        <span>SIGNATURES</span>
      </div>

      <div class="article-grid">
        <aside class="article-sidebar">
          <ArticleToc headings={headings} />
          <p class="source-stamp">
            Reference implementation<br />
            <code>Pom4H/hardware-wallet</code><br />
            <code>{data.sourceCommit.slice(0, 10)}</code>
          </p>
        </aside>

        <div class="prose" itemprop="articleBody">
          <section class="lesson-objectives" aria-labelledby="lesson-objectives-title">
            <p class="lesson-objectives__label">Learning goals</p>
            <h2 id="lesson-objectives-title">After this lesson, you can:</h2>
            <ol>
              {data.learningObjectives.map((objective) => <li>{objective}</li>)}
            </ol>
          </section>

          <slot />
        </div>
      </div>

      <footer class="article-end lesson-end">
        <span class="article-end__index">/{issue}</span>
        <div>
          <p>You now have the mental model needed to inspect a real wallet implementation without confusing the device, the keys, and the assets.</p>
          <a class="text-arrow" href={data.repository}>Inspect the open-source reference <span>↗</span></a>
        </div>
      </footer>
    </article>
  </main>

  <SiteFooter />

  <script is:inline>
    const progress = document.querySelector('.reading-progress span');
    let frame = 0;

    const updateProgress = () => {
      frame = 0;
      if (!(progress instanceof HTMLElement)) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
      progress.style.transform = `scaleX(${value})`;
    };

    window.addEventListener('scroll', () => {
      if (!frame) frame = window.requestAnimationFrame(updateProgress);
    }, { passive: true });

    updateProgress();
  </script>
</BaseLayout>
