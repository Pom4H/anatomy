---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const visible = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<nav class="toc toc--desktop" aria-label="Содержание статьи">
  <p class="toc__label">Содержание</p>
  <ol>
    {visible.map((heading) => (
      <li class:list={[`toc__depth-${heading.depth}`]}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ol>
</nav>

<details class="toc toc--mobile">
  <summary>Содержание</summary>
  <ol>
    {visible.map((heading) => (
      <li class:list={[`toc__depth-${heading.depth}`]}>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ol>
</details>
