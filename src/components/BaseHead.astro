---
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = 'og/default.png',
  type = 'website',
  publishedAt,
  updatedAt,
  tags = [],
  structuredData,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://pom4h.github.io');
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(`${base}${image.replace(/^\//, '')}`, site);
const rssUrl = new URL(`${base}rss.xml`, site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#f2eee4" />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

<title>{title}</title>
<link rel="canonical" href={canonical.href} />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="manifest" href={`${base}site.webmanifest`} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={rssUrl.href} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />

{type === 'article' && publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{type === 'article' && updatedAt && (
  <meta property="article:modified_time" content={updatedAt.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={SITE.authorUrl} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

{structuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
)}
